{
  "name": "@recv/api",
  "version": "0.1.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/app/app",
    "migrate": "NODE_ENV=${NODE_ENV:-development} ts-node src/db/migrate.ts",
    "migrate:rollback": "NODE_ENV=${NODE_ENV:-development} ts-node src/db/migrate.ts --rollback",
    "config:encrypt": "NODE_ENV=${NODE_ENV:-development} ts-node scripts/config-secret.ts",
    "config:rotate-key": "NODE_ENV=${NODE_ENV:-development} ts-node scripts/rotate-aes-key.ts",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@recv/shared": "0.1.0",
    "@solana/web3.js": "^1.98.4",
    "axios": "^1.7.0",
    "bignumber.js": "^11.0.0",
    "bitcoin-address-validation": "^2.2.3",
    "body-parser": "^1.20.2",
    "bs58": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^3.3.7",
    "nest-winston": "^1.9.7",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0",
    "tweetnacl": "^1.0.3",
    "typeorm": "^0.3.20",
    "winston": "^3.12.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
