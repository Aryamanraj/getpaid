NODE_ENV=development
PORT=3001

# Supabase — use the DIRECT connection (5432) for migrations.
# The transaction-mode pooler (6543) breaks prepared statements and TypeORM DDL.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_SSL=true

# 64-char hex (32 bytes). Decrypts every secret in core.PlatformConfig.
# Generate: openssl rand -hex 32
AES_ENCRYPTION_KEY=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# x-api-key for admin endpoints
ADMIN_API_KEY=
